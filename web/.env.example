# Copy to .env.local. Everything is optional; defaults give static mode.

# The ONE switch between static and realtime mode.
#   static   (default): pmtiles://<url to rinks.pmtiles>
#   realtime (Martin) : http://localhost:3000/rinks/{z}/{x}/{y}
# VITE_TILE_SOURCE=pmtiles://https://example.r2.dev/rinks.pmtiles

# Drive time. Default is the keyless FOSSGIS Valhalla demo server (fair use).
# VITE_VALHALLA_URL=https://valhalla1.openstreetmap.de
# Set an OpenRouteService key to use ORS instead (restrict it by domain).
# VITE_ORS_API_KEY=
